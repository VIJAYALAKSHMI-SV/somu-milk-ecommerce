# Copy this file to ".env" and change the values.

# Address of your backend API (used when VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:8081/api

# true  = demo mode: runs without a backend (data saved in the browser only)
# false = real mode: talks to the backend at VITE_API_URL
VITE_USE_MOCK=true
